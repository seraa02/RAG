# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# --- Anthropic (Claude) ---
# Used later for entity/relationship extraction from SEC filing chunks.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- SEC EDGAR access ---
# SEC requires a descriptive User-Agent identifying the requester (name + contact email)
# for all automated access. See: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="Your Name your_email@example.com"

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# --- PostgreSQL + pgvector (Vector DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=changeme123

# --- Embedding configuration ---
# Model choice (Voyage AI vs. local open-source model) is not finalized yet.
# This will be decided explicitly in Phase 2 before vector ingestion is built.
EMBEDDING_PROVIDER=undecided
EMBEDDING_MODEL=undecided
